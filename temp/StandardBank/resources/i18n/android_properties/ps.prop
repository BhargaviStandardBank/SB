0062\u0072\u003e\u003c\u002f\u0062\u0072\u003e\u0020\u0020\u0020\u0020\u0020\u0054\u0068\u0069\u0073\u0020\u0050\u0072\u0069\u0076\u0061\u0063\u0079\u0020\u0050\u006f\u006c\u0069\u0063\u0079\u002c\u0020\u0061\u0073\u0020\u0069\u006e\u0074\u0065\u0067\u0072\u0061\u006c\u0020\u0070\u0061\u0072\u0074\u0020\u006f\u0066\u0020\u0074\u0068\u0065\u0020\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u0020\u0054\u0065\u0072\u006d\u0073\u0020\u0061\u006e\u0064\u0020\u0043\u006f\u006e\u0064\u0069\u0074\u0069\u006f\u006e\u0073\u002c\u0020\u0065\u0078\u0070\u006c\u0061\u0069\u006e\u0073\u0020\u0068\u006f\u0077\u0020\u0049\u004f\u004d\u0020\u0063\u006f\u006c\u006c\u0065\u0063\u0074\u0073\u002c\u0020\u0072\u0065\u0067\u0069\u0073\u0074\u0065\u0072\u0073\u002c\u0020\u0073\u0074\u006f\u0072\u0065\u0073\u002c\u0020\u0075\u0073\u0065\u0073\u002c\u0020\u0073\u0068\u0061\u0072\u0065\u0073\u0020\u006f\u0072\u0020\u006f\u0074\u0068\u0065\u0072\u0077\u0069\u0073\u0065\u0020\u0070\u0072\u006f\u0063\u0065\u0073\u0073\u0065\u0073\u0020\u0079\u006f\u0075\u0072\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u006f\u006e\u0020\u0074\u0068\u0069\u0073\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u0020\u0042\u0079\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u0069\u006e\u0067\u0020\u0061\u006e\u0064\u0020\u0075\u0073\u0069\u006e\u0067\u0020\u0074\u0068\u0069\u0073\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002c\u0020\u0079\u006f\u0075\u0020\u0061\u0067\u0072\u0065\u0065\u0020\u0074\u006f\u0020\u0074\u0068\u0065\u0020\u0074\u0065\u0072\u006d\u0073\u0020\u0069\u006e\u0020\u0074\u0068\u0069\u0073\u0020\u0050\u0072\u0069\u0076\u0061\u0063\u0079\u0020\u0050\u006f\u006c\u0069\u0063\u0079\u002e\u0020\u003c\u0062\u0072\u003e\u003c\u002f\u0062\u0072\u003e\u0020\u0020\u0020\u0049\u004d\u0050\u004f\u0052\u0054\u0041\u004e\u0054\u0020\u004e\u004f\u0054\u0049\u0043\u0045\u003a\u0020\u0059\u006f\u0075\u0020\u006d\u0075\u0073\u0074\u0020\u0062\u0065\u0020\u006f\u0076\u0065\u0072\u0020\u0031\u0038\u0020\u0074\u006f\u0020\u0075\u0073\u0065\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u0020\u0049\u0066\u0020\u0079\u006f\u0075\u0020\u0061\u0072\u0065\u0020\u0075\u006e\u0064\u0065\u0072\u0020\u0031\u0038\u002c\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0061\u0072\u0065\u006e\u0074\u0073\u0020\u006f\u0072\u0020\u006c\u0065\u0067\u0061\u006c\u0020\u0067\u0075\u0061\u0072\u0064\u0069\u0061\u006e\u0073\u0020\u006d\u0075\u0073\u0074\u0020\u0062\u0065\u0020\u0074\u0068\u0065\u0020\u006f\u006e\u0065\u0073\u0020\u0074\u006f\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u0020\u0061\u006e\u0064\u0020\u0061\u0063\u0063\u006f\u006d\u0070\u0061\u006e\u0079\u0020\u0079\u006f\u0075\u0020\u0074\u0068\u0072\u006f\u0075\u0067\u0068\u0020\u0074\u0068\u0065\u0020\u0073\u0069\u0074\u0065\u0020\u0073\u0070\u0065\u0063\u0069\u0066\u0069\u0063\u0061\u006c\u006c\u0079\u0020\u0070\u0072\u006f\u0076\u0069\u0064\u0065\u0064\u0020\u0069\u006e\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0057\u0068\u006f\u0020\u0061\u0072\u0065\u0020\u0077\u0065\u003f\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0049\u004f\u004d\u0020\u0069\u0073\u0020\u0061\u0020\u0055\u006e\u0069\u0074\u0065\u0064\u0020\u004e\u0061\u0074\u0069\u006f\u006e\u0073\u0020\u0072\u0065\u006c\u0061\u0074\u0065\u0064\u0020\u006f\u0072\u0067\u0061\u006e\u0069\u007a\u0061\u0074\u0069\u006f\u006e\u0020\u0077\u006f\u0072\u006b\u0069\u006e\u0067\u0020\u006f\u006e\u0020\u006d\u0069\u0067\u0072\u0061\u0074\u0069\u006f\u006e\u0020\u0069\u0073\u0073\u0075\u0065\u0073\u002e\u0020\u0049\u004f\u004d\u0020\u0077\u006f\u0072\u006b\u0073\u0020\u0074\u006f\u0020\u0068\u0065\u006c\u0070\u0020\u0065\u006e\u0073\u0075\u0072\u0065\u0020\u0074\u0068\u0065\u0020\u006f\u0072\u0064\u0065\u0072\u006c\u0079\u0020\u0061\u006e\u0064\u0020\u0068\u0075\u006d\u0061\u006e\u0020\u006d\u0061\u006e\u0061\u0067\u0065\u006d\u0065\u006e\u0074\u0020\u006f\u0066\u0020\u006d\u0069\u0067\u0072\u0061\u0074\u0069\u006f\u006e\u0020\u0066\u006f\u0072\u0020\u0074\u0068\u0065\u0020\u0062\u0065\u006e\u0065\u0066\u0069\u0074\u0020\u006f\u0066\u0020\u0061\u006c\u006c\u002e\u0020\u0049\u0074\u0020\u0064\u006f\u0065\u0073\u0020\u0073\u006f\u0020\u0062\u0079\u0020\u0070\u0072\u006f\u0076\u0069\u0064\u0069\u006e\u0067\u0020\u0073\u0065\u0072\u0076\u0069\u0063\u0065\u0073\u0020\u0061\u006e\u0064\u0020\u0061\u0064\u0076\u0069\u0063\u0065\u0020\u0074\u006f\u0020\u0067\u006f\u0076\u0065\u0072\u006e\u006d\u0065\u006e\u0074\u0073\u0020\u0061\u006e\u0064\u0020\u006d\u0069\u0067\u0072\u0061\u006e\u0074\u0073\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0057\u0068\u0079\u0020\u0061\u0072\u0065\u0020\u0077\u0065\u0020\u0063\u006f\u006c\u006c\u0065\u0063\u0074\u0069\u006e\u0067\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0061\u0062\u006f\u0075\u0074\u0020\u0079\u006f\u0075\u003f\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0049\u004f\u004d\u0020\u0070\u0072\u006f\u0063\u0065\u0073\u0073\u0065\u0073\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0074\u006f\u0020\u0072\u0065\u0067\u0069\u0073\u0074\u0065\u0072\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0072\u006f\u0066\u0069\u006c\u0065\u0020\u0069\u006e\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u0020\u0042\u0079\u0020\u0064\u006f\u0069\u006e\u0067\u0020\u0073\u006f\u002c\u0020\u0079\u006f\u0075\u0020\u0061\u0067\u0072\u0065\u0065\u0020\u0074\u0068\u0061\u0074\u0020\u0049\u004f\u004d\u0020\u0063\u0072\u0065\u0061\u0074\u0065\u0073\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0069\u0067\u0069\u0074\u0061\u006c\u0020\u0068\u0065\u0061\u006c\u0074\u0068\u0020\u0073\u0070\u0061\u0063\u0065\u0020\u0074\u0068\u0061\u0074\u0020\u0061\u006c\u006c\u006f\u0077\u0073\u0020\u0079\u006f\u0075\u0020\u0074\u006f\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u0020\u0079\u006f\u0075\u0072\u0020\u0068\u0065\u0061\u006c\u0074\u0068\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u002c\u0020\u0063\u006f\u006e\u0073\u0075\u006c\u0074\u0020\u0061\u0070\u0070\u006f\u0069\u006e\u0074\u006d\u0065\u006e\u0074\u0073\u0020\u0061\u006e\u0064\u0020\u0063\u0061\u0072\u0072\u0079\u0020\u006f\u0075\u0074\u0020\u0070\u0072\u006f\u0063\u0065\u0064\u0075\u0072\u0065\u0073\u0020\u0069\u006e\u0020\u0061\u0020\u0073\u0069\u006d\u0070\u006c\u0065\u002c\u0020\u0073\u0065\u0063\u0075\u0072\u0065\u0020\u0061\u006e\u0064\u0020\u0063\u006f\u006e\u0066\u0069\u0064\u0065\u006e\u0074\u0069\u0061\u006c\u0020\u0077\u0061\u0079\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0057\u0068\u0061\u0074\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0061\u0072\u0065\u0020\u0077\u0065\u0020\u0063\u006f\u006c\u006c\u0065\u0063\u0074\u0069\u006e\u0067\u003f\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0020\u0057\u0068\u0065\u006e\u0020\u0079\u006f\u0075\u0020\u0072\u0065\u0067\u0069\u0073\u0074\u0065\u0072\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0072\u006f\u0066\u0069\u006c\u0065\u002c\u0020\u0079\u006f\u0075\u0020\u0061\u0067\u0072\u0065\u0065\u0020\u0074\u0068\u0061\u0074\u0020\u0074\u0068\u0065\u0020\u0066\u006f\u006c\u006c\u006f\u0077\u0069\u006e\u0067\u0020\u006d\u0061\u006e\u0064\u0061\u0074\u006f\u0072\u0079\u0020\u0066\u0069\u0065\u006c\u0064\u0073\u0020\u0077\u0069\u0074\u0068\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0061\u0072\u0065\u0020\u0072\u0065\u0063\u006f\u0072\u0064\u0065\u0064\u0020\u0069\u006e\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u003a\u0020\u0065\u006d\u0061\u0069\u006c\u0020\u0061\u0064\u0064\u0072\u0065\u0073\u0073\u002c\u0020\u0070\u0068\u006f\u006e\u0065\u0020\u006e\u0075\u006d\u0062\u0065\u0072\u002c\u0020\u006c\u0061\u0073\u0074\u0020\u006e\u0061\u006d\u0065\u002c\u0020\u0066\u0069\u0072\u0073\u0074\u0020\u006e\u0061\u006d\u0065\u002c\u0020\u006d\u0069\u0064\u0064\u006c\u0065\u0020\u006e\u0061\u006d\u0065\u002c\u0020\u0064\u0061\u0074\u0065\u0020\u006f\u0066\u0020\u0062\u0069\u0072\u0074\u0068\u002c\u0020\u0072\u0065\u006c\u0061\u0074\u0069\u006f\u006e\u0073\u0068\u0069\u0070\u002c\u0020\u0061\u006e\u0064\u0020\u0063\u006f\u0075\u006e\u0074\u0072\u0079\u0020\u006f\u0066\u0020\u006c\u006f\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u0020\u003c\u0062\u0072\u003e\u003c\u002f\u0062\u0072\u003e\u0020\u0020\u0020\u0020\u0020\u0059\u006f\u0075\u0020\u0077\u0069\u006c\u006c\u0020\u0068\u0061\u0076\u0065\u0020\u0061\u006e\u0020\u006f\u0070\u0070\u006f\u0072\u0074\u0075\u006e\u0069\u0074\u0079\u0020\u0074\u006f\u0020\u0063\u006f\u006e\u0066\u0069\u0072\u006d\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0075\u006e\u0074\u0069\u006c\u0020\u0079\u006f\u0075\u0020\u0065\u006e\u0072\u006f\u006c\u006c\u0020\u0079\u006f\u0075\u0072\u0020\u0064\u0065\u0076\u0069\u0063\u0065\u0020\u0069\u006e\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u0020\u0054\u0068\u0075\u0073\u002c\u0020\u0079\u006f\u0075\u0020\u0063\u0065\u0072\u0074\u0069\u0066\u0079\u0020\u0074\u0068\u0061\u0074\u0020\u0061\u006e\u0079\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u0079\u006f\u0075\u0020\u0070\u0072\u006f\u0076\u0069\u0064\u0065\u0020\u0074\u0068\u0072\u006f\u0075\u0067\u0068\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002c\u0020\u0069\u0073\u0020\u0074\u0072\u0075\u0065\u002c\u0020\u0061\u0063\u0063\u0075\u0072\u0061\u0074\u0065\u0020\u0061\u006e\u0064\u0020\u0075\u0070\u0020\u0074\u006f\u0020\u0064\u0061\u0074\u0065\u002e\u003c\u0062\u0072\u003e\u003c\u002f\u0062\u0072\u003e\u0020\u0020\u0020\u0059\u006f\u0075\u0020\u0061\u0067\u0072\u0065\u0065\u0020\u0074\u006f\u0020\u006d\u0061\u0069\u006e\u0074\u0061\u0069\u006e\u0020\u0074\u0068\u0065\u0020\u0073\u0065\u0063\u0075\u0072\u0069\u0074\u0079\u0020\u006f\u0066\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0072\u006f\u0066\u0069\u006c\u0065\u0020\u0061\u006e\u0064\u0020\u006e\u006f\u0074\u0020\u0073\u0068\u0061\u0072\u0069\u006e\u0067\u0020\u0074\u0068\u0065\u0020\u0064\u0065\u0074\u0061\u0069\u006c\u0073\u0020\u0074\u006f\u0020\u0061\u006e\u0079\u0020\u0074\u0068\u0069\u0072\u0064\u0020\u0070\u0061\u0072\u0074\u0079\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0057\u0068\u0069\u0063\u0068\u0020\u0064\u0061\u0074\u0061\u0020\u0063\u006f\u006e\u0074\u0061\u0069\u006e\u0073\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0072\u006f\u0066\u0069\u006c\u0065\u003f\u0020\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0020\u0055\u0070\u006f\u006e\u0020\u0079\u006f\u0075\u0072\u0020\u0063\u006f\u006e\u0066\u0069\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u002c\u0020\u0074\u0068\u0065\u0020\u0072\u0065\u006c\u0065\u0076\u0061\u006e\u0074\u0020\u0064\u0061\u0074\u0061\u0020\u0072\u0065\u006c\u0061\u0074\u0065\u0064\u0020\u0074\u006f\u0020\u0079\u006f\u0075\u0072\u0020\u0068\u0065\u0061\u006c\u0074\u0068\u0020\u0073\u0074\u0061\u0074\u0075\u0073\u0020\u0061\u006e\u0064\u002f\u006f\u0072\u0020\u006f\u0066\u0020\u0079\u006f\u0075\u0072\u0020\u0064\u0065\u0070\u0065\u006e\u0064\u0065\u006e\u0074\u0073\u0020\u0070\u0072\u006f\u0063\u0065\u0073\u0073\u0065\u0064\u0020\u0062\u0079\u0020\u0049\u004f\u004d\u0020\u0074\u0068\u0072\u006f\u0075\u0067\u0068\u0020\u0074\u0068\u0065\u0020\u0048\u0065\u0061\u006c\u0074\u0068\u0020\u0041\u0073\u0073\u0065\u0073\u0073\u006d\u0065\u006e\u0074\u0073\u0020\u0070\u0072\u006f\u0063\u0065\u0073\u0073\u0065\u0073\u0020\u0077\u0069\u006c\u006c\u0020\u0062\u0065\u0020\u0075\u0070\u006c\u006f\u0061\u0064\u0065\u0064\u0020\u0061\u006e\u0064\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u0069\u0062\u006c\u0065\u0020\u0069\u006e\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0046\u006f\u0072\u0020\u0077\u0068\u0061\u0074\u0020\u0070\u0075\u0072\u0070\u006f\u0073\u0065\u0020\u0077\u0061\u0073\u0020\u0079\u006f\u0075\u0072\u0020\u0064\u0061\u0074\u0061\u0020\u0063\u006f\u006c\u006c\u0065\u0063\u0074\u0065\u0064\u003f\u003c\u002f\u0068\u0033\u003e\u0020\u0020\u003c\u0070\u003e\u0054\u0068\u0065\u0020\u0070\u0075\u0072\u0070\u006f\u0073\u0065\u0020\u006f\u0066\u0020\u0074\u0068\u0069\u0073\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0069\u0073\u0020\u0074\u006f\u0020\u0070\u0072\u006f\u0076\u0069\u0064\u0065\u0020\u0049\u004f\u004d\u0020\u0062\u0065\u006e\u0065\u0066\u0069\u0063\u0069\u0061\u0072\u0069\u0065\u0073\u0020\u0077\u0069\u0074\u0068\u0020\u0061\u0020\u0070\u006c\u0061\u0074\u0066\u006f\u0072\u006d\u0020\u0074\u006f\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u0020\u0074\u0068\u0065\u0069\u0072\u0020\u0068\u0065\u0061\u006c\u0074\u0068\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u002c\u0020\u0063\u006f\u006e\u0073\u0075\u006c\u0074\u0020\u0061\u0070\u0070\u006f\u0069\u006e\u0074\u006d\u0065\u006e\u0074\u0073\u0020\u0061\u006e\u0064\u0020\u0063\u0061\u0072\u0072\u0079\u0020\u006f\u0075\u0074\u0020\u0070\u0072\u006f\u0063\u0065\u0064\u0075\u0072\u0065\u0073\u0020\u0069\u006e\u0020\u0061\u0020\u0073\u0069\u006d\u0070\u006c\u0065\u002c\u0020\u0073\u0065\u0063\u0075\u0072\u0065\u0020\u0061\u006e\u0064\u0020\u0063\u006f\u006e\u0066\u0069\u0064\u0065\u006e\u0074\u0069\u0061\u006c\u0020\u0077\u0061\u0079\u002e\u003c\u0062\u0072\u003e\u003c\u002f\u0062\u0072\u003e\u0020\u0020\u0020\u0059\u006f\u0075\u0072\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0077\u0061\u0073\u0020\u0063\u006f\u006c\u006c\u0065\u0063\u0074\u0065\u0064\u0020\u0061\u006e\u0064\u0020\u0073\u0074\u006f\u0072\u0065\u0064\u0020\u0069\u006e\u0020\u0074\u0068\u0065\u0020\u0049\u004f\u004d\u2019\u0073\u0020\u0064\u0061\u0074\u0061\u0062\u0061\u0073\u0065\u0020\u0066\u006f\u0072\u0020\u0074\u0068\u0065\u0020\u0070\u0075\u0072\u0070\u006f\u0073\u0065\u0020\u006f\u0066\u0020\u0070\u0072\u006f\u0076\u0069\u0064\u0069\u006e\u0067\u0020\u0079\u006f\u0075\u0020\u0077\u0069\u0074\u0068\u0020\u0076\u0061\u0063\u0063\u0069\u006e\u0061\u0074\u0069\u006f\u006e\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u002c\u0020\u006e\u006f\u0074\u0069\u0066\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0073\u002c\u0020\u0063\u0065\u0072\u0074\u0069\u0066\u0069\u0063\u0061\u0074\u0065\u0073\u002c\u0020\u0068\u0065\u0061\u006c\u0074\u0068\u0020\u0065\u0064\u0075\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0062\u0079\u0020\u006f\u006e\u0065\u0020\u006f\u0066\u0020\u0049\u004f\u004d\u2019\u0073\u0020\u004d\u0069\u0067\u0072\u0061\u0074\u0069\u006f\u006e\u0020\u0048\u0065\u0061\u006c\u0074\u0068\u0020\u0041\u0073\u0073\u0065\u0073\u0073\u006d\u0065\u006e\u0074\u0020\u0043\u0065\u006e\u0074\u0065\u0072\u0073\u002e\u003c\u0062\u0072\u003e\u003c\u002f\u0062\u0072\u003e\u0020\u0020\u0020\u0044\u0061\u0074\u0061\u0020\u006f\u0066\u0020\u0079\u006f\u0075\u0072\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u0065\u0073\u0020\u0061\u006e\u0064\u0020\u0075\u0073\u0065\u0020\u006f\u0066\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0077\u006f\u0075\u006c\u0064\u0020\u0062\u0065\u0020\u0064\u0065\u002d\u0069\u0064\u0065\u006e\u0074\u0069\u0066\u0069\u0065\u0064\u0020\u0062\u0079\u0020\u0072\u0065\u006d\u006f\u0076\u0069\u006e\u0067\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u0069\u0066\u0020\u0074\u0068\u0065\u0079\u0020\u006e\u0065\u0065\u0064\u0020\u0074\u006f\u0020\u0062\u0065\u0020\u0075\u0073\u0065\u0064\u0020\u0066\u006f\u0072\u0020\u0072\u0065\u0073\u0065\u0061\u0072\u0063\u0068\u0020\u0073\u0075\u0063\u0068\u0020\u0061\u0073\u0020\u0061\u006e\u0061\u006c\u0079\u0073\u0069\u0073\u0020\u006f\u0066\u0020\u006d\u0069\u0067\u0072\u0061\u0074\u0069\u006f\u006e\u0020\u0068\u0065\u0061\u006c\u0074\u0068\u0020\u0069\u0073\u0073\u0075\u0065\u0073\u0020\u0074\u006f\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0020\u0070\u006f\u006c\u0069\u0063\u0079\u0020\u006f\u0072\u0020\u0070\u0072\u006f\u0067\u0072\u0061\u006d\u006d\u0065\u0020\u0065\u0076\u0061\u006c\u0075\u0061\u0074\u0069\u006f\u006e\u0020\u0074\u006f\u0020\u0069\u006d\u0070\u0072\u006f\u0076\u0065\u0020\u0074\u0068\u0065\u0020\u0073\u0065\u0072\u0076\u0069\u0063\u0065\u002e\u003c\u0062\u0072\u003e\u003c\u002f\u0062\u0072\u003e\u0020\u0020\u0020\u0020\u0020\u0049\u004f\u004d\u0020\u0077\u0069\u006c\u006c\u0020\u006e\u006f\u0074\u0020\u0073\u0065\u006c\u006c\u0020\u006f\u0072\u0020\u0072\u0065\u006e\u0074\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0063\u006f\u006c\u006c\u0065\u0063\u0074\u0065\u0064\u0020\u0074\u0068\u0072\u006f\u0075\u0067\u0068\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u0020\u0020\u0020\u003c\u0068\u0033\u003e\u0057\u0068\u0061\u0074\u0020\u0073\u0065\u0063\u0075\u0072\u0069\u0074\u0079\u0020\u006d\u0065\u0061\u0073\u0075\u0072\u0065\u0073\u0020\u0061\u0072\u0065\u0020\u0074\u0061\u006b\u0065\u006e\u0020\u0074\u006f\u0020\u0073\u0061\u0066\u0065\u0067\u0075\u0061\u0072\u0064\u0020\u0079\u006f\u0075\u0072\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0041\u006e\u0079\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0063\u006f\u006c\u006c\u0065\u0063\u0074\u0065\u0064\u002c\u0020\u0072\u0065\u0063\u0065\u0069\u0076\u0065\u0064\u002c\u0020\u0075\u0073\u0065\u0064\u002c\u0020\u0074\u0072\u0061\u006e\u0073\u0066\u0065\u0072\u0072\u0065\u0064\u002c\u0020\u0073\u0074\u006f\u0072\u0065\u0064\u0020\u006f\u0072\u0020\u006f\u0074\u0068\u0065\u0072\u0077\u0069\u0073\u0065\u0020\u0070\u0072\u006f\u0063\u0065\u0073\u0073\u0065\u0064\u0020\u0062\u0079\u0020\u0049\u004f\u004d\u0020\u0061\u0072\u0065\u0020\u0070\u0072\u006f\u0074\u0065\u0063\u0074\u0065\u0064\u0020\u0062\u0079\u0020\u0073\u0074\u0072\u0069\u0063\u0074\u0020\u0063\u006f\u006e\u0064\u0069\u0074\u0069\u006f\u006e\u0073\u0020\u006f\u0066\u0020\u0063\u006f\u006e\u0066\u0069\u0064\u0065\u006e\u0074\u0069\u0061\u006c\u0069\u0074\u0079\u0020\u0061\u006e\u0064\u0020\u0073\u0065\u0063\u0075\u0072\u0069\u0074\u0079\u002c\u0020\u0069\u006e\u0020\u006c\u0069\u006e\u0065\u0020\u0077\u0069\u0074\u0068\u0020\u0074\u0068\u0065\u0020\u0049\u004f\u004d\u0020\u0044\u0061\u0074\u0061\u0020\u0050\u0072\u006f\u0074\u0065\u0063\u0074\u0069\u006f\u006e\u0020\u0050\u0072\u0069\u006e\u0063\u0069\u0070\u006c\u0065\u0073\u003a\u003c\u0061\u0020\u0068\u0072\u0065\u0066\u003d\u0022\u0068\u0074\u0074\u0070\u0073\u003a\u002f\u002f\u0070\u0075\u0062\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0073\u002e\u0069\u006f\u006d\u002e\u0069\u006e\u0074\u002f\u0073\u0079\u0073\u0074\u0065\u006d\u002f\u0066\u0069\u006c\u0065\u0073\u002f\u0070\u0064\u0066\u002f\u0069\u006f\u006d\u0064\u0061\u0074\u0061\u0070\u0072\u006f\u0074\u0065\u0063\u0074\u0069\u006f\u006e\u005f\u0077\u0065\u0062\u002e\u0070\u0064\u0066\u0022\u003e\u003c\u0075\u003e\u0068\u0074\u0074\u0070\u0073\u003a\u002f\u002f\u0070\u0075\u0062\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0073\u002e\u0069\u006f\u006d\u002e\u0069\u006e\u0074\u002f\u0073\u0079\u0073\u0074\u0065\u006d\u002f\u003c\u0062\u0072\u003e\u0066\u0069\u006c\u0065\u0073\u002f\u0070\u0064\u0066\u002f\u0069\u006f\u006d\u0064\u0061\u0074\u0061\u0070\u0072\u006f\u0074\u0065\u0063\u0074\u0069\u006f\u006e\u005f\u0077\u0065\u0062\u002e\u0070\u0064\u0066\u003c\u002f\u0075\u003e\u003c\u002f\u0061\u003e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0057\u0068\u006f\u0020\u0068\u0061\u0073\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u0020\u0074\u006f\u0020\u0074\u0068\u0065\u0073\u0065\u0020\u0064\u0061\u0074\u0061\u003f\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0045\u0078\u0063\u0065\u0070\u0074\u0020\u0066\u006f\u0072\u0020\u0074\u0068\u0065\u0020\u0070\u0075\u0072\u0070\u006f\u0073\u0065\u0073\u0020\u0066\u006f\u0072\u0020\u0077\u0068\u0069\u0063\u0068\u0020\u0079\u006f\u0075\u0020\u0061\u0063\u0063\u0065\u0070\u0074\u0065\u0064\u0020\u0074\u006f\u0020\u0070\u0072\u006f\u0076\u0069\u0064\u0065\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u002c\u0020\u0049\u004f\u004d\u0020\u0077\u0069\u006c\u006c\u0020\u006e\u006f\u0074\u0020\u0064\u0069\u0073\u0063\u006c\u006f\u0073\u0065\u0020\u0079\u006f\u0075\u0072\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u006f\u0072\u0020\u0079\u006f\u0075\u0072\u0020\u0061\u0063\u0063\u006f\u0075\u006e\u0074\u0020\u0069\u006e\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0074\u006f\u0020\u0061\u006e\u0079\u0020\u0074\u0068\u0069\u0072\u0064\u0020\u0070\u0061\u0072\u0074\u0079\u002c\u0020\u0077\u0069\u0074\u0068\u006f\u0075\u0074\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0072\u0069\u006f\u0072\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0065\u0064\u0020\u0063\u006f\u006e\u0073\u0065\u006e\u0074\u002e\u0020\u0059\u006f\u0075\u0020\u0063\u0061\u006e\u0020\u0072\u0065\u0061\u0064\u0020\u006d\u006f\u0072\u0065\u0020\u0061\u0062\u006f\u0075\u0074\u0020\u006f\u0075\u0072\u0020\u0064\u0061\u0074\u0061\u0020\u0073\u0068\u0061\u0072\u0069\u006e\u0067\u0020\u0070\u006f\u006c\u0069\u0063\u0079\u0020\u0062\u0079\u0020\u0076\u0069\u0065\u0077\u0069\u006e\u0067\u0020\u0074\u0068\u0065\u0020\u0049\u004f\u004d\u0020\u0044\u0061\u0074\u0061\u0020\u0050\u0072\u006f\u0074\u0065\u0063\u0074\u0069\u006f\u006e\u0020\u0050\u0072\u0069\u006e\u0063\u0069\u0070\u006c\u0065\u0073\u002c\u0020\u0061\u0076\u0061\u0069\u006c\u0061\u0062\u006c\u0065\u0020\u003c\u0061\u0020\u0068\u0072\u0065\u0066\u003d\u0022\u0068\u0074\u0074\u0070\u0073\u003a\u002f\u002f\u0077\u0077\u0077\u002e\u0069\u006f\u006d\u002e\u0069\u006e\u0074\u002f\u0064\u0061\u0074\u0061\u002d\u0070\u0072\u006f\u0074\u0065\u0063\u0074\u0069\u006f\u006e\u0022\u0020\u0074\u0061\u0072\u0067\u0065\u0074\u003d\u0022\u005f\u0062\u006c\u0061\u006e\u006b\u0022\u0020\u006f\u006e\u0063\u006c\u0069\u0063\u006b\u003d\u0027\u0077\u0069\u006e\u0064\u006f\u0077\u002e\u006f\u0070\u0065\u006e\u0028\u0022\u0068\u0074\u0074\u0070\u0073\u003a\u002f\u002f\u0077\u0077\u0077\u002e\u0069\u006f\u006d\u002e\u0069\u006e\u0074\u002f\u0064\u0061\u0074\u0061\u002d\u0070\u0072\u006f\u0074\u0065\u0063\u0074\u0069\u006f\u006e\u0022\u0029\u003b\u0020\u0072\u0065\u0074\u0075\u0072\u006e\u0020\u0066\u0061\u006c\u0073\u0065\u003b\u0027\u003e\u003c\u0075\u003e\u0068\u0065\u0072\u0065\u003c\u002f\u0075\u003e\u003c\u002f\u0061\u003e\u003c\u0062\u0072\u003e\u003c\u002f\u0062\u0072\u003e\u0020\u0020\u0041\u0063\u0063\u0065\u0073\u0073\u0020\u0074\u006f\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0077\u0069\u006c\u006c\u0020\u0062\u0065\u0020\u006c\u0069\u006d\u0069\u0074\u0065\u0064\u0020\u0074\u006f\u0020\u0049\u004f\u004d\u0020\u0073\u0074\u0061\u0066\u0066\u0020\u006d\u0065\u006d\u0062\u0065\u0072\u0073\u0020\u0064\u0065\u0064\u0069\u0063\u0061\u0074\u0065\u0064\u0020\u0074\u006f\u0020\u006d\u0061\u006e\u0061\u0067\u0069\u006e\u0067\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u0020\u0041\u006c\u006c\u0020\u0049\u004f\u004d\u0020\u0073\u0074\u0061\u0066\u0066\u0020\u006d\u0065\u006d\u0062\u0065\u0072\u0073\u0020\u006d\u0075\u0073\u0074\u0020\u0061\u0064\u0068\u0065\u0072\u0065\u0020\u0074\u006f\u0020\u0074\u0068\u0065\u0020\u0049\u004f\u004d\u0020\u0044\u0061\u0074\u0061\u0020\u0050\u0072\u006f\u0074\u0065\u0063\u0074\u0069\u006f\u006e\u0020\u0050\u0072\u0069\u006e\u0063\u0069\u0070\u006c\u0065\u0073\u0020\u0061\u006e\u0064\u0020\u0061\u0072\u0065\u0020\u0073\u0074\u0072\u0069\u0063\u0074\u006c\u0079\u0020\u0062\u006f\u0075\u006e\u0064\u0020\u0062\u0079\u0020\u0063\u006f\u006e\u0066\u0069\u0064\u0065\u006e\u0074\u0069\u0061\u006c\u0069\u0074\u0079\u0020\u006f\u0062\u006c\u0069\u0067\u0061\u0074\u0069\u006f\u006e\u0073\u002e\u003c\u0062\u0072\u003e\u003c\u002f\u0062\u0072\u003e\u0020\u0020\u0020\u0020\u0059\u006f\u0075\u0072\u0020\u0064\u0061\u0074\u0061\u0020\u0077\u0069\u006c\u006c\u0020\u0062\u0065\u0020\u0074\u0072\u0065\u0061\u0074\u0065\u0064\u0020\u0061\u0073\u0020\u0063\u006f\u006e\u0066\u0069\u0064\u0065\u006e\u0074\u0069\u0061\u006c\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0057\u0068\u0061\u0074\u0020\u0061\u0072\u0065\u0020\u0079\u006f\u0075\u0072\u0020\u0072\u0069\u0067\u0068\u0074\u0073\u0020\u0061\u006e\u0064\u0020\u0068\u006f\u0077\u0020\u0063\u0061\u006e\u0020\u0079\u006f\u0075\u0020\u006d\u0061\u006e\u0061\u0067\u0065\u0020\u0079\u006f\u0075\u0072\u0020\u0064\u0061\u0074\u0061\u003f\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0020\u0059\u006f\u0075\u0020\u0068\u0061\u0076\u0065\u0020\u0074\u0068\u0065\u0020\u0072\u0069\u0067\u0068\u0074\u0020\u0061\u006e\u0064\u0020\u0072\u0065\u0073\u0070\u006f\u006e\u0073\u0069\u0062\u0069\u006c\u0069\u0074\u0079\u0020\u0074\u006f\u0020\u0075\u0070\u0064\u0061\u0074\u0065\u0020\u0061\u006c\u006c\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0079\u006f\u0075\u0020\u0068\u0061\u0076\u0065\u0020\u0073\u0075\u0070\u0070\u006c\u0069\u0065\u0064\u0020\u0074\u006f\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u0020\u0059\u006f\u0075\u0020\u006d\u0061\u0079\u0020\u0063\u0068\u0061\u006e\u0067\u0065\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0061\u0074\u0020\u0061\u006e\u0079\u0020\u0074\u0069\u006d\u0065\u002e\u0020\u0046\u006f\u0072\u0020\u0074\u0068\u0061\u0074\u0020\u0079\u006f\u0075\u0020\u0077\u0069\u006c\u006c\u0020\u006e\u0065\u0065\u0064\u0020\u0074\u006f\u0020\u0063\u006f\u006e\u0074\u0061\u0063\u0074\u0020\u0049\u004f\u004d\u0020\u004d\u0065\u0064\u0069\u0063\u0061\u006c\u0020\u0073\u0074\u0061\u0066\u0066\u0020\u0061\u006e\u0064\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0020\u0061\u0062\u006f\u0075\u0074\u0020\u0061\u006e\u0079\u0020\u0063\u0068\u0061\u006e\u0067\u0065\u0020\u0069\u006e\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u002e\u003c\u0062\u0072\u003e\u003c\u002f\u0062\u0072\u003e\u0020\u0020\u0059\u006f\u0075\u0020\u0063\u0061\u006e\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0069\u006e\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0061\u0074\u0020\u0061\u006e\u0079\u0020\u0074\u0069\u006d\u0065\u0020\u0062\u0079\u0020\u006c\u006f\u0067\u0067\u0069\u006e\u0067\u0020\u0069\u006e\u0020\u0061\u006e\u0064\u0020\u0063\u0068\u0065\u0063\u006b\u0069\u006e\u0067\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0072\u006f\u0066\u0069\u006c\u0065\u002e\u0020\u0059\u006f\u0075\u0020\u0063\u0061\u006e\u0020\u0061\u006c\u0073\u006f\u0020\u0076\u0069\u0065\u0077\u0020\u0079\u006f\u0075\u0072\u0020\u006e\u006f\u0074\u0069\u0066\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0073\u0020\u0068\u0069\u0073\u0074\u006f\u0072\u0079\u0020\u0061\u006e\u0064\u0020\u0076\u0061\u0063\u0063\u0069\u006e\u0061\u0074\u0069\u006f\u006e\u0020\u0064\u006f\u0063\u0075\u006d\u0065\u006e\u0074\u0061\u0074\u0069\u006f\u006e\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0048\u006f\u0077\u0020\u006c\u006f\u006e\u0067\u0020\u0077\u0069\u006c\u006c\u0020\u0077\u0065\u0020\u006b\u0065\u0065\u0070\u0020\u0079\u006f\u0075\u0072\u0020\u0064\u0061\u0074\u0061\u0020\u0066\u006f\u0072\u003f\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0020\u0059\u006f\u0075\u0072\u0020\u0064\u0061\u0074\u0061\u0020\u0077\u0069\u006c\u006c\u0020\u0062\u0065\u0020\u0072\u0065\u0074\u0061\u0069\u006e\u0065\u0064\u0020\u0069\u006e\u0020\u0061\u0063\u0063\u006f\u0072\u0064\u0061\u006e\u0063\u0065\u0020\u0077\u0069\u0074\u0068\u0020\u0049\u004f\u004d\u0020\u0064\u0061\u0074\u0061\u0020\u0072\u0065\u0074\u0065\u006e\u0074\u0069\u006f\u006e\u0020\u0070\u006f\u006c\u0069\u0063\u0079\u002c\u0020\u0077\u0068\u0069\u0063\u0068\u0020\u0069\u0073\u0020\u0063\u0075\u0072\u0072\u0065\u006e\u0074\u006c\u0079\u0020\u006e\u006f\u0020\u0066\u0065\u0077\u0065\u0072\u0020\u0074\u0068\u0061\u006e\u0020\u0037\u0020\u0079\u0065\u0061\u0072\u0073\u0020\u0066\u006f\u006c\u006c\u006f\u0077\u0069\u006e\u0067\u0020\u0063\u006f\u006c\u006c\u0065\u0063\u0074\u0069\u006f\u006e\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0057\u0068\u0061\u0074\u0020\u006c\u0061\u0077\u0073\u0020\u0061\u006e\u0064\u0020\u0072\u0065\u0067\u0075\u006c\u0061\u0074\u0069\u006f\u006e\u0073\u0020\u0067\u006f\u0076\u0065\u0072\u006e\u0020\u0074\u0068\u0065\u0020\u0070\u0072\u006f\u0063\u0065\u0073\u0073\u0069\u006e\u0067\u0020\u006f\u0066\u0020\u0079\u006f\u0075\u0072\u0020\u0064\u0061\u0074\u0061\u003f\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0020\u0041\u006c\u006c\u0020\u0079\u006f\u0075\u0072\u0020\u0064\u0061\u0074\u0061\u0020\u0069\u0073\u0020\u0070\u0072\u006f\u0063\u0065\u0073\u0073\u0065\u0064\u0020\u0069\u006e\u0020\u0061\u0063\u0063\u006f\u0072\u0064\u0061\u006e\u0063\u0065\u0020\u0077\u0069\u0074\u0068\u0020\u0074\u0068\u0065\u0020\u0049\u004f\u004d\u0020\u0044\u0061\u0074\u0061\u0020\u0050\u0072\u006f\u0074\u0065\u0063\u0074\u0069\u006f\u006e\u0020\u0050\u0072\u0069\u006e\u0063\u0069\u0070\u006c\u0065\u0073\u002e\u0020\u0049\u004f\u004d\u0020\u0072\u0065\u0073\u0065\u0072\u0076\u0065\u0073\u0020\u0074\u0068\u0065\u0020\u0072\u0069\u0067\u0068\u0074\u0020\u0074\u006f\u0020\u0063\u0068\u0061\u006e\u0067\u0065\u0020\u0074\u0068\u0069\u0073\u0020\u0050\u0072\u0069\u0076\u0061\u0063\u0079\u0020\u0050\u006f\u006c\u0069\u0063\u0079\u0020\u0061\u0074\u0020\u0061\u006e\u0079\u0020\u0074\u0069\u006d\u0065\u002e\u0020\u0057\u0068\u0065\u006e\u0065\u0076\u0065\u0072\u0020\u0063\u0068\u0061\u006e\u0067\u0065\u0073\u0020\u0061\u0072\u0065\u0020\u006d\u0061\u0064\u0065\u002c\u0020\u0079\u006f\u0075\u0020\u0077\u0069\u006c\u006c\u0020\u0062\u0065\u0020\u006e\u006f\u0074\u0069\u0066\u0069\u0065\u0064\u0020\u0074\u0068\u0072\u006f\u0075\u0067\u0068\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0061\u006e\u0064\u0020\u0077\u0069\u006c\u006c\u0020\u006e\u0065\u0065\u0064\u0020\u0074\u006f\u0020\u0061\u0067\u0072\u0065\u0065\u0020\u0069\u006e\u0020\u006f\u0072\u0064\u0065\u0072\u0020\u0074\u006f\u0020\u0063\u006f\u006e\u0074\u0069\u006e\u0075\u0065\u0020\u0075\u0073\u0069\u006e\u0067\u0020\u0069\u0074\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0057\u0068\u006f\u0020\u0074\u006f\u0020\u0063\u006f\u006e\u0074\u0061\u0063\u0074\u0020\u0069\u0066\u0020\u0079\u006f\u0075\u0020\u0068\u0061\u0076\u0065\u0020\u0071\u0075\u0065\u0073\u0074\u0069\u006f\u006e\u0073\u0020\u006f\u0072\u0020\u0063\u006f\u006d\u0070\u006c\u0061\u0069\u006e\u0074\u0073\u003f\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0046\u006f\u0072\u0020\u0061\u006e\u0079\u0020\u0071\u0075\u0065\u0073\u0074\u0069\u006f\u006e\u0073\u0020\u0069\u006e\u0020\u0072\u0065\u006c\u0061\u0074\u0069\u006f\u006e\u0020\u0074\u006f\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0067\u0061\u0074\u0068\u0065\u0072\u0065\u0064\u0020\u0074\u0068\u0072\u006f\u0075\u0067\u0068\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002c\u0020\u0079\u006f\u0075\u0020\u006d\u0061\u0079\u0020\u0063\u006f\u006e\u0074\u0061\u0063\u0074\u003a\u0020\u003c\u0061\u0020\u0068\u0072\u0065\u0066\u003d\u0022\u0076\u0061\u0063\u0063\u0069\u006e\u0065\u0061\u0070\u0070\u0040\u0069\u006f\u006d\u002e\u0069\u006e\u0074\u0022\u003e\u003c\u0075\u003e\u0076\u0061\u0063\u0063\u0069\u006e\u0065\u0061\u0070\u0070\u0040\u0069\u006f\u006d\u002e\u0069\u006e\u0074\u003c\u002f\u0075\u003e\u003c\u002f\u0061\u003e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0020\u0020\u0032\u002e\u0020\u0047\u0045\u004e\u0045\u0052\u0041\u004c\u0020\u0054\u0045\u0052\u004d\u0053\u0020\u0041\u004e\u0044\u0020\u0043\u004f\u004e\u0044\u0049\u0054\u0049\u004f\u004e\u0053\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0020\u0020\u0050\u004c\u0045\u0041\u0053\u0045\u0020\u0052\u0045\u0041\u0044\u0020\u0054\u0048\u0045\u0053\u0045\u0020\u0054\u0045\u0052\u004d\u0053\u0020\u0043\u0041\u0052\u0045\u0046\u0055\u004c\u004c\u0059\u002e\u0020\u0054\u0048\u0045\u0020\u0041\u0043\u0043\u0045\u0053\u0053\u0020\u0054\u004f\u0020\u004f\u0052\u0020\u0055\u0053\u0045\u0020\u004f\u0046\u0020\u0054\u0048\u0045\u0020\u0041\u0050\u0050\u004c\u0049\u0043\u0041\u0054\u0049\u004f\u004e\u0020\u0049\u004d\u0050\u004c\u0049\u0045\u0053\u0020\u0054\u0048\u0041\u0054\u0020\u0059\u004f\u0055\u0020\u0048\u0041\u0056\u0045\u0020\u0052\u0045\u0041\u0044\u002c\u0020\u0055\u004e\u0044\u0045\u0052\u0053\u0054\u004f\u004f\u0044\u0020\u0041\u004e\u0044\u0020\u0041\u0043\u0043\u0045\u0050\u0054\u0045\u0044\u0020\u0041\u004c\u004c\u0020\u004f\u0046\u0020\u0054\u0048\u0045\u004d\u0020\u0057\u0049\u0054\u0048\u004f\u0055\u0054\u0020\u0052\u0045\u0053\u0045\u0052\u0056\u0041\u0054\u0049\u004f\u004e\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0031\u002e\u0020\u0055\u0073\u0065\u0020\u006f\u0066\u0020\u0074\u0068\u0065\u0020\u0056\u0061\u0063\u0063\u0069\u006e\u0061\u0074\u0069\u006f\u006e\u0020\u0041\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u003c\u002f\u0068\u0033\u003e\u0020\u0020\u003c\u0070\u003e\u0059\u006f\u0075\u0020\u0061\u0067\u0072\u0065\u0065\u0020\u0074\u006f\u0020\u0074\u0068\u0065\u0020\u0066\u006f\u006c\u006c\u006f\u0077\u0069\u006e\u0067\u0020\u006f\u0062\u006c\u0069\u0067\u0061\u0074\u0069\u006f\u006e\u0073\u003a\u0020\u003c\u0062\u0072\u003e\u0020\u0020\u25cf\u00a0\u004e\u006f\u0074\u0020\u0074\u006f\u0020\u0072\u0065\u0067\u0069\u0073\u0074\u0065\u0072\u0020\u0069\u0066\u0020\u0079\u006f\u0075\u0020\u0061\u0072\u0065\u0020\u0075\u006e\u0064\u0065\u0072\u0020\u0074\u0068\u0065\u0020\u0061\u0067\u0065\u0020\u006f\u0066\u0020\u0031\u0038\u003b\u003c\u0062\u0072\u003e\u0020\u0020\u25cf\u00a0\u00a0\u0020\u004e\u006f\u0074\u0020\u0074\u006f\u0020\u006d\u0069\u0073\u0072\u0065\u0070\u0072\u0065\u0073\u0065\u006e\u0074\u0020\u0079\u006f\u0075\u0072\u0020\u0072\u0065\u006c\u0061\u0074\u0069\u006f\u006e\u0073\u0068\u0069\u0070\u0020\u0074\u006f\u0020\u0061\u006e\u006f\u0074\u0068\u0065\u0072\u0020\u0075\u0073\u0065\u0072\u003b\u003c\u0062\u0072\u003e\u0020\u0020\u25cf\u00a0\u00a0\u0020\u004e\u006f\u0074\u0020\u0074\u006f\u0020\u0075\u0073\u0065\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0074\u006f\u0020\u0061\u0063\u0074\u0020\u0069\u006e\u0020\u0061\u006e\u0020\u0075\u006e\u006c\u0061\u0077\u0066\u0075\u006c\u002c\u0020\u006f\u0062\u0073\u0063\u0065\u006e\u0065\u002c\u0020\u0064\u0069\u0073\u0063\u0072\u0069\u006d\u0069\u006e\u0061\u0074\u006f\u0072\u0079\u0020\u006f\u0072\u0020\u0061\u0062\u0075\u0073\u0069\u0076\u0065\u0020\u006d\u0061\u006e\u006e\u0065\u0072\u0020\u006f\u0072\u0020\u0070\u0072\u006f\u006d\u006f\u0074\u0065\u0020\u0073\u0075\u0063\u0068\u0020\u0061\u0063\u0074\u0069\u006f\u006e\u0073\u003b\u003c\u0062\u0072\u003e\u0020\u25cf\u00a0\u00a0\u0020\u004e\u006f\u0074\u0020\u0074\u006f\u0020\u0073\u0065\u006c\u006c\u002c\u0020\u0072\u0065\u006e\u0074\u002c\u0020\u0074\u0072\u0061\u0064\u0065\u0020\u006f\u0072\u0020\u006f\u0074\u0068\u0065\u0072\u0077\u0069\u0073\u0065\u0020\u006d\u006f\u006e\u0065\u0074\u0069\u007a\u0065\u0020\u0061\u006e\u0079\u0020\u0066\u0065\u0061\u0074\u0075\u0072\u0065\u0020\u006f\u0066\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u006f\u0072\u0020\u0061\u006e\u0079\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u0065\u0064\u0020\u0074\u0068\u0072\u006f\u0075\u0067\u0068\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u003b\u0020\u003c\u0062\u0072\u003e\u0020\u25cf\u00a0\u00a0\u0020\u004e\u006f\u0074\u0020\u0074\u006f\u0020\u0075\u0073\u0065\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0074\u006f\u0020\u0076\u0069\u006f\u006c\u0061\u0074\u0065\u0020\u0074\u0068\u0065\u0020\u0069\u006e\u0074\u0065\u006c\u006c\u0065\u0063\u0074\u0075\u0061\u006c\u0020\u0070\u0072\u006f\u0070\u0065\u0072\u0074\u0079\u0020\u0072\u0069\u0067\u0068\u0074\u0073\u0020\u006f\u0066\u0020\u006f\u0074\u0068\u0065\u0072\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0073\u0020\u006f\u0072\u0020\u0065\u006e\u0074\u0069\u0074\u0069\u0065\u0073\u003b\u003c\u0062\u0072\u003e\u0020\u0020\u25cf\u00a0\u00a0\u0020\u004e\u006f\u0074\u0020\u0074\u006f\u0020\u0075\u0073\u0065\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0074\u006f\u0020\u0069\u006e\u0066\u0072\u0069\u006e\u0067\u0065\u0020\u0061\u006e\u0079\u0020\u0072\u0069\u0067\u0068\u0074\u0073\u0020\u0072\u0065\u006c\u0061\u0074\u0069\u006e\u0067\u0020\u0074\u006f\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u002c\u0020\u0070\u0072\u0069\u0076\u0061\u0063\u0079\u0020\u006f\u0072\u0020\u0070\u0072\u006f\u0074\u0065\u0063\u0074\u0069\u006f\u006e\u0020\u006f\u0066\u0020\u0074\u0068\u0065\u0020\u0069\u006d\u0061\u0067\u0065\u0020\u006f\u0066\u0020\u0061\u006e\u0079\u0020\u006e\u0061\u0074\u0075\u0072\u0061\u006c\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0020\u0061\u006e\u0064\u002f\u006f\u0072\u0020\u0074\u0068\u0065\u0020\u0072\u0065\u0070\u0075\u0074\u0061\u0074\u0069\u006f\u006e\u0020\u006f\u0066\u0020\u0061\u0020\u0074\u0068\u0069\u0072\u0064\u0020\u0070\u0061\u0072\u0074\u0079\u0020\u0062\u0079\u0020\u006d\u0065\u0061\u006e\u0073\u0020\u006f\u0066\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u003b\u003c\u0062\u0072\u003e\u0020\u25cf\u00a0\u00a0\u0020\u004e\u006f\u0074\u0020\u0074\u006f\u0020\u0075\u0073\u0065\u0020\u0062\u006f\u0074\u0073\u002c\u0020\u0073\u0063\u0072\u0069\u0070\u0074\u0073\u0020\u006f\u0072\u0020\u0061\u006e\u0079\u0020\u006f\u0074\u0068\u0065\u0072\u0020\u0061\u0075\u0074\u006f\u006d\u0061\u0074\u0065\u0064\u0020\u006d\u0065\u0074\u0068\u006f\u0064\u0020\u0074\u006f\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u0020\u0061\u006e\u0064\u0020\u0063\u006f\u006c\u006c\u0065\u0063\u0074\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u006f\u006e\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u003b\u003c\u0062\u0072\u003e\u0020\u25cf\u00a0\u00a0\u0020\u004e\u006f\u0074\u0020\u0074\u006f\u0020\u006f\u0076\u0065\u0072\u0072\u0069\u0064\u0065\u0020\u0061\u006e\u0079\u0020\u0066\u0065\u0061\u0074\u0075\u0072\u0065\u0020\u006f\u0066\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u0020\u0049\u006e\u0020\u0074\u0068\u0065\u0020\u0065\u0076\u0065\u006e\u0074\u0020\u006f\u0066\u0020\u0075\u006e\u0066\u0075\u006c\u0066\u0069\u006c\u006c\u006d\u0065\u006e\u0074\u0020\u0062\u0079\u0020\u0074\u0068\u0065\u0020\u0075\u0073\u0065\u0072\u002c\u0020\u0074\u0068\u0065\u0020\u0049\u004f\u004d\u0020\u0072\u0065\u0073\u0065\u0072\u0076\u0065\u0073\u0020\u0074\u0068\u0065\u0020\u0072\u0069\u0067\u0068\u0074\u0020\u0074\u006f\u0020\u0074\u0061\u006b\u0065\u0020\u0061\u0070\u0070\u0072\u006f\u0070\u0072\u0069\u0061\u0074\u0065\u0020\u006c\u0065\u0067\u0061\u006c\u0020\u0061\u0063\u0074\u0069\u006f\u006e\u0073\u002c\u0020\u0061\u0073\u0020\u0077\u0065\u006c\u006c\u0020\u0061\u0073\u0020\u0074\u0068\u0065\u0020\u0072\u0069\u0067\u0068\u0074\u0020\u0074\u006f\u0020\u0072\u0065\u0073\u0074\u0072\u0069\u0063\u0074\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u0020\u0074\u006f\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0032\u002e\u0020\u0044\u0065\u006e\u0079\u0069\u006e\u0067\u0020\u0041\u0063\u0063\u0065\u0073\u0073\u0020\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0049\u004f\u004d\u0020\u0072\u0065\u0073\u0065\u0072\u0076\u0065\u0073\u0020\u0074\u0068\u0065\u0020\u0072\u0069\u0067\u0068\u0074\u0020\u0074\u006f\u0020\u0064\u0065\u006e\u0079\u002c\u0020\u0061\u0074\u0020\u0069\u0074\u0073\u0020\u0073\u006f\u006c\u0065\u0020\u0064\u0069\u0073\u0063\u0072\u0065\u0074\u0069\u006f\u006e\u002c\u0020\u0061\u006e\u0079\u0020\u0075\u0073\u0065\u0072\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u0020\u0074\u006f\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u006f\u0072\u0020\u0061\u006e\u0079\u0020\u0070\u006f\u0072\u0074\u0069\u006f\u006e\u0020\u0074\u0068\u0065\u0072\u0065\u006f\u0066\u0020\u0077\u0069\u0074\u0068\u006f\u0075\u0074\u0020\u006e\u006f\u0074\u0069\u0063\u0065\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0033\u002e\u0020\u0044\u0069\u0073\u0063\u006c\u0061\u0069\u006d\u0065\u0072\u003c\u002f\u0068\u0033\u003e\u0020\u0020\u003c\u0070\u003e\u0054\u0068\u0065\u0020\u0063\u006f\u006e\u0074\u0065\u006e\u0074\u0020\u0069\u006e\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0069\u0073\u0020\u0070\u0072\u006f\u0076\u0069\u0064\u0065\u0064\u0020\u006f\u006e\u0020\u0061\u006e\u0020\u0022\u0061\u0073\u0020\u0069\u0073\u0022\u0020\u0062\u0061\u0073\u0069\u0073\u002c\u0020\u0077\u0069\u0074\u0068\u006f\u0075\u0074\u0020\u0077\u0061\u0072\u0072\u0061\u006e\u0074\u0079\u0020\u006f\u0066\u0020\u0061\u006e\u0079\u0020\u006b\u0069\u006e\u0064\u002e\u0020\u0049\u004f\u004d\u0020\u0073\u0070\u0065\u0063\u0069\u0066\u0069\u0063\u0061\u006c\u006c\u0079\u0020\u0064\u006f\u0065\u0073\u0020\u006e\u006f\u0074\u0020\u006d\u0061\u006b\u0065\u0020\u0061\u006e\u0079\u0020\u0077\u0061\u0072\u0072\u0061\u006e\u0074\u0069\u0065\u0073\u0020\u0061\u0073\u0020\u0074\u006f\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u0072\u006f\u0070\u0072\u0069\u0061\u0074\u0065\u006e\u0065\u0073\u0073\u002c\u0020\u0071\u0075\u0061\u006c\u0069\u0074\u0079\u002c\u0020\u0074\u0069\u006d\u0065\u006c\u0069\u006e\u0065\u0073\u0073\u002c\u0020\u0061\u0063\u0063\u0075\u0072\u0061\u0063\u0079\u0020\u006f\u0072\u0020\u0063\u006f\u006d\u0070\u006c\u0065\u0074\u0065\u006e\u0065\u0073\u0073\u0020\u006f\u0066\u0020\u0074\u0068\u0065\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u0061\u006e\u0064\u0020\u0073\u0065\u0072\u0076\u0069\u0063\u0065\u0073\u0020\u006f\u0066\u0066\u0065\u0072\u0065\u0064\u0020\u0074\u0068\u0072\u006f\u0075\u0067\u0068\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u0020\u0057\u0068\u0069\u006c\u0065\u0020\u0049\u004f\u004d\u0020\u0063\u0061\u006e\u006e\u006f\u0074\u0020\u0067\u0075\u0061\u0072\u0061\u006e\u0074\u0065\u0065\u0020\u0074\u0068\u0061\u0074\u0020\u0074\u0068\u0065\u0072\u0065\u0020\u0061\u0072\u0065\u0020\u006e\u006f\u0020\u0065\u0072\u0072\u006f\u0072\u0073\u0020\u0069\u006e\u0020\u0074\u0068\u0065\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u0070\u0072\u006f\u0076\u0069\u0064\u0065\u0064\u002c\u0020\u0069\u0074\u0020\u0064\u006f\u0065\u0073\u0020\u0065\u006e\u0064\u0065\u0061\u0076\u006f\u0072\u0020\u0074\u006f\u0020\u0063\u006f\u0072\u0072\u0065\u0063\u0074\u0020\u0065\u0072\u0072\u006f\u0072\u0073\u0020\u0074\u0068\u0061\u0074\u0020\u0061\u0072\u0065\u0020\u0064\u0072\u0061\u0077\u006e\u0020\u0074\u006f\u0020\u0069\u0074\u0073\u0020\u0061\u0074\u0074\u0065\u006e\u0074\u0069\u006f\u006e\u002e\u0020\u0054\u0068\u0065\u0020\u0063\u006f\u006e\u0074\u0065\u006e\u0074\u0020\u006f\u0066\u0020\u0074\u0068\u0069\u0073\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0064\u006f\u0065\u0073\u0020\u006e\u006f\u0074\u0020\u0072\u0065\u0070\u006c\u0061\u0063\u0065\u0020\u0074\u0068\u0065\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0069\u007a\u0065\u0064\u0020\u0063\u0061\u0072\u0065\u0020\u006d\u0061\u0064\u0065\u0020\u0062\u0079\u0020\u0068\u0065\u0061\u006c\u0074\u0068\u0063\u0061\u0072\u0065\u0020\u0070\u0072\u006f\u0066\u0065\u0073\u0073\u0069\u006f\u006e\u0061\u006c\u0073\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0034\u002e\u0020\u0047\u0065\u006f\u0067\u0072\u0061\u0070\u0068\u0069\u0063\u0020\u004e\u0061\u006d\u0065\u0073\u003c\u002f\u0068\u0033\u003e\u0020\u0020\u003c\u0070\u003e\u0057\u0068\u0069\u006c\u0065\u0020\u0049\u004f\u004d\u0020\u0066\u006f\u006c\u006c\u006f\u0077\u0073\u0020\u0074\u0068\u0065\u0020\u0063\u0072\u0069\u0074\u0065\u0072\u0069\u0061\u0020\u006f\u0066\u0020\u0074\u0068\u0065\u0020\u0055\u006e\u0069\u0074\u0065\u0064\u0020\u004e\u0061\u0074\u0069\u006f\u006e\u0073\u0020\u0069\u006e\u0020\u0074\u0068\u0065\u0020\u0067\u0065\u006f\u0067\u0072\u0061\u0070\u0068\u0069\u0063\u0020\u006e\u0061\u006d\u0065\u0073\u0020\u0061\u006e\u0064\u0020\u0072\u0065\u006c\u0061\u0074\u0065\u0064\u0020\u0064\u0061\u0074\u0061\u002c\u0020\u0074\u0068\u0065\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u0073\u0068\u006f\u0077\u006e\u0020\u0069\u006e\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0069\u0073\u0020\u006e\u006f\u0074\u0020\u0077\u0061\u0072\u0072\u0061\u006e\u0074\u0065\u0064\u0020\u0074\u006f\u0020\u0062\u0065\u0020\u0065\u0072\u0072\u006f\u0072\u0020\u0066\u0072\u0065\u0065\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0035\u002e\u0020\u0042\u0075\u0067\u0073\u002c\u0020\u0056\u0069\u0072\u0075\u0073\u0065\u0073\u0020\u0061\u006e\u0064\u0020\u006f\u0074\u0068\u0065\u0072\u0020\u004d\u0061\u006c\u0077\u0061\u0072\u0065\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0057\u0068\u0069\u006c\u0065\u0020\u0049\u004f\u004d\u0020\u006d\u0061\u006b\u0065\u0073\u0020\u0065\u0076\u0065\u0072\u0079\u0020\u0065\u0066\u0066\u006f\u0072\u0074\u0020\u0074\u006f\u0020\u0065\u006e\u0073\u0075\u0072\u0065\u0020\u0074\u0068\u0065\u0020\u006d\u0061\u0074\u0065\u0072\u0069\u0061\u006c\u0073\u0020\u0061\u0076\u0061\u0069\u006c\u0061\u0062\u006c\u0065\u0020\u006f\u006e\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0061\u0072\u0065\u0020\u0066\u0072\u0065\u0065\u0020\u006f\u0066\u0020\u0061\u006e\u0079\u0020\u0073\u006f\u0066\u0074\u0077\u0061\u0072\u0065\u0020\u0076\u0069\u0072\u0075\u0073\u002c\u0020\u0069\u0074\u0020\u0063\u0061\u006e\u006e\u006f\u0074\u0020\u0067\u0075\u0061\u0072\u0061\u006e\u0074\u0065\u0065\u0020\u0074\u0068\u0061\u0074\u0020\u0074\u0068\u0065\u0079\u0020\u0061\u0072\u0065\u0020\u0066\u0072\u0065\u0065\u0020\u0066\u0072\u006f\u006d\u0020\u0061\u006e\u0079\u0020\u006f\u0072\u0020\u0061\u006c\u006c\u0020\u0073\u006f\u0066\u0074\u0077\u0061\u0072\u0065\u0020\u0076\u0069\u0072\u0075\u0073\u0065\u0073\u002e\u0020\u0049\u004f\u004d\u0020\u0069\u0073\u0020\u006e\u006f\u0074\u0020\u0072\u0065\u0073\u0070\u006f\u006e\u0073\u0069\u0062\u006c\u0065\u0020\u0066\u006f\u0072\u0020\u0061\u006e\u0079\u0020\u006c\u006f\u0073\u0073\u0020\u006f\u0072\u0020\u0064\u0061\u006d\u0061\u0067\u0065\u0020\u0063\u0061\u0075\u0073\u0065\u0064\u0020\u0062\u0079\u0020\u0073\u006f\u0066\u0074\u0077\u0061\u0072\u0065\u0020\u0061\u006e\u0064\u0020\u0072\u0065\u006c\u0061\u0074\u0065\u0064\u0020\u0063\u006f\u0064\u0065\u0073\u002c\u0020\u0069\u006e\u0063\u006c\u0075\u0064\u0069\u006e\u0067\u0020\u0076\u0069\u0072\u0075\u0073\u0065\u0073\u0020\u0061\u006e\u0064\u0020\u0077\u006f\u0072\u006d\u0073\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0036\u002e\u0020\u004c\u0069\u006e\u006b\u0073\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0041\u0074\u0020\u006e\u006f\u0020\u0070\u006f\u0069\u006e\u0074\u002c\u0020\u0074\u0068\u0065\u0020\u0073\u0065\u0074\u0074\u0069\u006e\u0067\u002d\u0075\u0070\u0020\u006f\u0066\u0020\u006c\u0069\u006e\u006b\u0073\u0020\u0077\u0069\u006c\u006c\u0020\u0069\u006d\u0070\u006c\u0079\u0020\u0061\u006e\u0079\u0020\u0072\u0065\u006c\u0061\u0074\u0069\u006f\u006e\u0073\u0068\u0069\u0070\u0020\u006f\u0072\u0020\u0063\u006f\u006c\u006c\u0061\u0062\u006f\u0072\u0061\u0074\u0069\u006f\u006e\u0020\u0077\u0069\u0074\u0068\u002c\u0020\u006f\u0072\u0020\u0073\u0075\u0070\u0070\u006f\u0072\u0074\u0020\u0062\u0079\u0020\u0049\u004f\u004d\u002e\u0020\u0050\u0061\u0072\u0074\u0069\u0063\u0075\u006c\u0061\u0072\u006c\u0079\u002c\u0020\u0069\u0074\u0020\u0069\u0073\u0020\u006e\u006f\u0074\u0020\u0070\u0065\u0072\u006d\u0069\u0074\u0074\u0065\u0064\u0020\u0074\u006f\u0020\u0073\u0065\u0074\u002d\u0075\u0070\u0020\u0061\u0020\u006c\u0069\u006e\u006b\u0020\u0074\u0068\u0061\u0074\u002c\u0020\u0066\u0072\u0061\u0075\u0064\u0075\u006c\u0065\u006e\u0074\u006c\u0079\u002c\u0020\u006d\u0061\u0079\u0020\u006c\u0065\u0061\u0064\u0020\u0074\u006f\u0020\u006f\u0072\u0020\u0065\u0073\u0074\u0061\u0062\u006c\u0069\u0073\u0068\u0020\u0061\u006e\u0079\u0020\u0074\u0079\u0070\u0065\u0020\u006f\u0066\u0020\u0072\u0065\u006c\u0061\u0074\u0069\u006f\u006e\u0073\u0068\u0069\u0070\u0020\u0077\u0069\u0074\u0068\u0020\u0049\u004f\u004d\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0037\u002e\u0020\u0044\u0061\u0074\u0061\u0020\u0050\u0072\u006f\u0074\u0065\u0063\u0074\u0069\u006f\u006e\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0049\u004f\u004d\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0073\u0020\u0079\u006f\u0075\u0020\u0061\u006e\u0064\u0020\u0061\u006e\u0079\u0020\u0074\u0068\u0069\u0072\u0064\u0020\u0070\u0061\u0072\u0074\u0069\u0065\u0073\u0020\u0077\u0068\u006f\u0073\u0065\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0061\u0072\u0065\u0020\u0070\u0072\u006f\u0063\u0065\u0073\u0073\u0065\u0064\u0020\u0062\u0079\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0061\u0062\u006f\u0075\u0074\u0020\u0069\u0074\u0073\u0020\u0050\u0072\u0069\u0076\u0061\u0063\u0079\u0020\u0050\u006f\u006c\u0069\u0063\u0079\u002c\u0020\u0077\u0068\u0069\u0063\u0068\u0020\u0069\u0073\u0020\u0061\u0076\u0061\u0069\u006c\u0061\u0062\u006c\u0065\u0020\u0061\u0062\u006f\u0076\u0065\u0020\u0020\u003c\u0061\u0020\u0068\u0072\u0065\u0066\u003d\u0022\u0023\u0050\u0072\u0069\u0076\u0061\u0063\u0079\u005f\u0050\u006f\u006c\u0069\u0063\u0079\u0022\u003e\u003c\u0075\u003e\u0050\u0072\u0069\u0076\u0061\u0063\u0079\u0020\u0050\u006f\u006c\u0069\u0063\u0079\u003c\u002f\u0075\u003e\u003c\u002f\u0061\u003e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0038\u002e\u0020\u0053\u0065\u0063\u0075\u0072\u0069\u0074\u0079\u0020\u004d\u0065\u0061\u0073\u0075\u0072\u0065\u0073\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0054\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0069\u006d\u0070\u006c\u0065\u006d\u0065\u006e\u0074\u0073\u0020\u0061\u0020\u0073\u0065\u0072\u0069\u0065\u0073\u0020\u006f\u0066\u0020\u0074\u0065\u0063\u0068\u006e\u006f\u006c\u006f\u0067\u0069\u0065\u0073\u0020\u0061\u006e\u0064\u0020\u0073\u0065\u0063\u0075\u0072\u0069\u0074\u0079\u0020\u006d\u0065\u0061\u0073\u0075\u0072\u0065\u0073\u0020\u0069\u006e\u0020\u006f\u0072\u0064\u0065\u0072\u0020\u0074\u006f\u0020\u0073\u0061\u0066\u0065\u0067\u0075\u0061\u0072\u0064\u0020\u0074\u0068\u0065\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u006d\u0061\u0069\u006e\u0074\u0061\u0069\u006e\u0065\u0064\u0020\u0062\u0079\u0020\u0049\u004f\u004d\u0020\u0066\u0072\u006f\u006d\u0020\u006d\u0069\u0073\u0075\u0073\u0065\u002c\u0020\u0075\u006e\u0061\u0075\u0074\u0068\u006f\u0072\u0069\u007a\u0065\u0064\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u0020\u006f\u0072\u0020\u0064\u0069\u0073\u0063\u006c\u006f\u0073\u0075\u0072\u0065\u002c\u0020\u0061\u006c\u0074\u0065\u0072\u0061\u0074\u0069\u006f\u006e\u0020\u006f\u0072\u0020\u006c\u006f\u0073\u0073\u002e\u0020\u0041\u006c\u0074\u0068\u006f\u0075\u0067\u0068\u0020\u0049\u004f\u004d\u0020\u0061\u0070\u0070\u006c\u0069\u0065\u0073\u0020\u0072\u0065\u0061\u0073\u006f\u006e\u0061\u0062\u006c\u0065\u0020\u006d\u0065\u0061\u006e\u0073\u0020\u0074\u006f\u0020\u0065\u006e\u0073\u0075\u0072\u0065\u0020\u0074\u0068\u0061\u0074\u0020\u0074\u0068\u0065\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u0079\u006f\u0075\u0020\u0070\u0072\u006f\u0076\u0069\u0064\u0065\u0020\u0069\u0073\u0020\u006e\u006f\u0074\u0020\u0075\u0073\u0065\u0064\u0020\u0062\u0079\u0020\u0074\u0068\u0069\u0072\u0064\u0020\u0070\u0061\u0072\u0074\u0069\u0065\u0073\u0020\u0066\u006f\u0072\u0020\u0070\u0075\u0072\u0070\u006f\u0073\u0065\u0073\u0020\u006f\u0074\u0068\u0065\u0072\u0020\u0074\u0068\u0061\u006e\u0020\u0074\u0068\u006f\u0073\u0065\u0020\u0066\u006f\u0072\u0020\u0077\u0068\u0069\u0063\u0068\u0020\u0079\u006f\u0075\u0020\u0061\u0063\u0063\u0065\u0070\u0074\u0065\u0064\u0020\u0074\u006f\u0020\u0070\u0072\u006f\u0076\u0069\u0064\u0065\u0020\u0069\u0074\u002c\u0020\u0049\u004f\u004d\u0020\u0063\u0061\u006e\u006e\u006f\u0074\u0020\u0067\u0075\u0061\u0072\u0061\u006e\u0074\u0065\u0065\u0020\u0074\u0068\u0061\u0074\u0020\u0075\u006e\u0061\u0075\u0074\u0068\u006f\u0072\u0069\u007a\u0065\u0064\u0020\u0074\u0068\u0069\u0072\u0064\u0020\u0070\u0061\u0072\u0074\u0069\u0065\u0073\u0020\u0077\u0069\u006c\u006c\u0020\u006e\u0065\u0076\u0065\u0072\u0020\u0062\u0065\u0020\u0061\u0062\u006c\u0065\u0020\u0074\u006f\u0020\u0064\u0065\u0066\u0065\u0061\u0074\u0020\u0073\u0065\u0063\u0075\u0072\u0069\u0074\u0079\u0020\u006d\u0065\u0061\u0073\u0075\u0072\u0065\u0073\u0020\u006f\u0072\u0020\u0075\u0073\u0065\u0020\u0079\u006f\u0075\u0072\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u0020\u0066\u006f\u0072\u0020\u0069\u006d\u0070\u0072\u006f\u0070\u0065\u0072\u0020\u0070\u0075\u0072\u0070\u006f\u0073\u0065\u0073\u002e\u0020\u0059\u006f\u0075\u0020\u0073\u0068\u006f\u0075\u006c\u0064\u0020\u0062\u0065\u0020\u0061\u0077\u0061\u0072\u0065\u0020\u0074\u0068\u0061\u0074\u0020\u006e\u006f\u0020\u0074\u0072\u0061\u006e\u0073\u006d\u0069\u0073\u0073\u0069\u006f\u006e\u0020\u006f\u0066\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u0076\u0069\u0061\u0020\u0074\u0068\u0065\u0020\u0069\u006e\u0074\u0065\u0072\u006e\u0065\u0074\u0020\u0069\u0073\u0020\u0065\u0076\u0065\u0072\u0020\u0074\u006f\u0074\u0061\u006c\u006c\u0079\u0020\u0073\u0065\u0063\u0075\u0072\u0065\u002e\u0020\u0054\u0068\u0065\u0020\u0073\u0065\u0074\u0074\u0069\u006e\u0067\u002d\u0075\u0070\u0020\u006f\u0066\u0020\u0079\u006f\u0075\u0072\u0020\u0061\u0063\u0063\u006f\u0075\u006e\u0074\u0020\u0061\u006e\u0064\u0020\u0074\u0068\u0065\u0020\u0074\u0072\u0061\u006e\u0073\u006d\u0069\u0073\u0073\u0069\u006f\u006e\u0020\u006f\u0066\u0020\u0061\u006e\u0079\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u002c\u0020\u0069\u006e\u0063\u006c\u0075\u0064\u0069\u006e\u0067\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0064\u0061\u0074\u0061\u002c\u0020\u0069\u0073\u0020\u0061\u0074\u0020\u0079\u006f\u0075\u0072\u0020\u006f\u0077\u006e\u0020\u0072\u0069\u0073\u006b\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0039\u002e\u0020\u0049\u006e\u0074\u0065\u006c\u006c\u0065\u0063\u0074\u0075\u0061\u006c\u0020\u0050\u0072\u006f\u0070\u0065\u0072\u0074\u0079\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0039\u002e\u0031\u0020\u0049\u004f\u004d\u0020\u0067\u0072\u0061\u006e\u0074\u0073\u0020\u0079\u006f\u0075\u0020\u0061\u0020\u006e\u006f\u006e\u002d\u0065\u0078\u0063\u006c\u0075\u0073\u0069\u0076\u0065\u002c\u0020\u006e\u006f\u006e\u002d\u0074\u0072\u0061\u006e\u0073\u0066\u0065\u0072\u0061\u0062\u006c\u0065\u0020\u0061\u006e\u0064\u0020\u0066\u0072\u0065\u0065\u0020\u006c\u0069\u0063\u0065\u006e\u0073\u0065\u0020\u006f\u006e\u006c\u0079\u0020\u0066\u006f\u0072\u0020\u0070\u0072\u0069\u0076\u0061\u0074\u0065\u0020\u0061\u006e\u0064\u0020\u0070\u0065\u0072\u0073\u006f\u006e\u0061\u006c\u0020\u0075\u0073\u0065\u0020\u006f\u0066\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u0020\u0054\u0068\u0069\u0073\u0020\u006c\u0069\u0063\u0065\u006e\u0073\u0065\u0020\u0077\u0069\u006c\u006c\u0020\u0068\u0061\u0076\u0065\u0020\u0061\u0020\u0064\u0075\u0072\u0061\u0074\u0069\u006f\u006e\u0020\u0065\u0071\u0075\u0061\u006c\u0020\u0074\u006f\u0020\u0074\u0068\u0061\u0074\u0020\u006f\u0066\u0020\u0074\u0068\u0065\u0020\u006c\u0065\u0067\u0061\u006c\u0020\u0072\u0065\u006c\u0061\u0074\u0069\u006f\u006e\u0073\u0068\u0069\u0070\u0020\u0065\u0073\u0074\u0061\u0062\u006c\u0069\u0073\u0068\u0065\u0064\u0020\u0069\u006e\u0020\u0074\u0068\u0065\u0073\u0065\u0020\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u0020\u0054\u0065\u0072\u006d\u0073\u0020\u0061\u006e\u0064\u0020\u0043\u006f\u006e\u0064\u0069\u0074\u0069\u006f\u006e\u0073\u002e\u0020\u0039\u002e\u0032\u0020\u0041\u006c\u006c\u0020\u0069\u006e\u0074\u0065\u006c\u006c\u0065\u0063\u0074\u0075\u0061\u006c\u0020\u0070\u0072\u006f\u0070\u0065\u0072\u0074\u0079\u0020\u0072\u0069\u0067\u0068\u0074\u0073\u0020\u0072\u0065\u006c\u0061\u0074\u0069\u006e\u0067\u0020\u0074\u006f\u0020\u0049\u004f\u004d\u002d\u006f\u0077\u006e\u0065\u0064\u0020\u006d\u0061\u0074\u0065\u0072\u0069\u0061\u006c\u0073\u0020\u0070\u0072\u006f\u0076\u0069\u0064\u0065\u0064\u0020\u0074\u0068\u0072\u006f\u0075\u0067\u0068\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0073\u0068\u0061\u006c\u006c\u0020\u0072\u0065\u006d\u0061\u0069\u006e\u0020\u0076\u0065\u0073\u0074\u0065\u0064\u0020\u0069\u006e\u0020\u0049\u004f\u004d\u002c\u0020\u0075\u006e\u006c\u0065\u0073\u0073\u0020\u006f\u0074\u0068\u0065\u0072\u0077\u0069\u0073\u0065\u0020\u0073\u0074\u0061\u0074\u0065\u0064\u002e\u0020\u0049\u004f\u004d\u0020\u0068\u0061\u0073\u0020\u0074\u0068\u0065\u0020\u0063\u006f\u0070\u0079\u0072\u0069\u0067\u0068\u0074\u0020\u006f\u0066\u0020\u0061\u006c\u006c\u0020\u006d\u0061\u0074\u0065\u0072\u0069\u0061\u006c\u0073\u0020\u0070\u0072\u006f\u0076\u0069\u0064\u0065\u0064\u0020\u0074\u0068\u0072\u006f\u0075\u0067\u0068\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002c\u0020\u0075\u006e\u006c\u0065\u0073\u0073\u0020\u006f\u0074\u0068\u0065\u0072\u0077\u0069\u0073\u0065\u0020\u0073\u0074\u0061\u0074\u0065\u0064\u002e\u0020\u0054\u0068\u0065\u0020\u006d\u0061\u0074\u0065\u0072\u0069\u0061\u006c\u0073\u0020\u006d\u0061\u0079\u0020\u0062\u0065\u0020\u0076\u0069\u0065\u0077\u0065\u0064\u002c\u0020\u0064\u006f\u0077\u006e\u006c\u006f\u0061\u0064\u0065\u0064\u002c\u0020\u0061\u006e\u0064\u0020\u0070\u0072\u0069\u006e\u0074\u0065\u0064\u0020\u0066\u006f\u0072\u0020\u006e\u006f\u006e\u002d\u0063\u006f\u006d\u006d\u0065\u0072\u0063\u0069\u0061\u006c\u0020\u0075\u0073\u0065\u0020\u006f\u006e\u006c\u0079\u002c\u0020\u0077\u0069\u0074\u0068\u006f\u0075\u0074\u0020\u0061\u006e\u0079\u0020\u0072\u0069\u0067\u0068\u0074\u0020\u0074\u006f\u0020\u0073\u0065\u006c\u006c\u002c\u0020\u0072\u0065\u0073\u0065\u006c\u006c\u002c\u0020\u006f\u0072\u0020\u0063\u0072\u0065\u0061\u0074\u0065\u0020\u0064\u0065\u0072\u0069\u0076\u0061\u0074\u0069\u0076\u0065\u0020\u0077\u006f\u0072\u006b\u0073\u0020\u0074\u0068\u0065\u0072\u0065\u0066\u0072\u006f\u006d\u002e\u0020\u0050\u0061\u0072\u0074\u0069\u0063\u0075\u006c\u0061\u0072\u006c\u0079\u002c\u0020\u0061\u006e\u0064\u0020\u0069\u006e\u0063\u006c\u0075\u0064\u0065\u0064\u0020\u0062\u0075\u0074\u0020\u006e\u006f\u0074\u0020\u006c\u0069\u006d\u0069\u0074\u0065\u0064\u0020\u0074\u006f\u002c\u0020\u0074\u0068\u0065\u0020\u0075\u0073\u0065\u0072\u0020\u006d\u0061\u0079\u0020\u006e\u006f\u0074\u0020\u0075\u0073\u0065\u002c\u0020\u0061\u0063\u0063\u0065\u0073\u0073\u002c\u0020\u0063\u006f\u0070\u0079\u002c\u0020\u0072\u0065\u0070\u0072\u006f\u0064\u0075\u0063\u0065\u002c\u0020\u0074\u0072\u0061\u006e\u0073\u0066\u006f\u0072\u006d\u0020\u006f\u0072\u0020\u0063\u0072\u0065\u0061\u0074\u0065\u0020\u0064\u0065\u0072\u0069\u0076\u0061\u0074\u0069\u0076\u0065\u0020\u0077\u006f\u0072\u006b\u0073\u002c\u0020\u0064\u0065\u0063\u006f\u006d\u0070\u0069\u006c\u0065\u002c\u0020\u0064\u0065\u0063\u006f\u0064\u0065\u002c\u0020\u0070\u0065\u0072\u0066\u006f\u0072\u006d\u0020\u0072\u0065\u0076\u0065\u0072\u0073\u0065\u0020\u0065\u006e\u0067\u0069\u006e\u0065\u0065\u0072\u0069\u006e\u0067\u002c\u0020\u0074\u0072\u0061\u006e\u0073\u0066\u0065\u0072\u002c\u0020\u0074\u0072\u0061\u006e\u0073\u006d\u0069\u0074\u002c\u0020\u0072\u0065\u006e\u0074\u002c\u0020\u0064\u0069\u0073\u0074\u0072\u0069\u0062\u0075\u0074\u0065\u002c\u0020\u006c\u0069\u0063\u0065\u006e\u0073\u0065\u002c\u0020\u0073\u0075\u0062\u006c\u0069\u0063\u0065\u006e\u0073\u0065\u002c\u0020\u0073\u0065\u006c\u006c\u0020\u006f\u0072\u0020\u0074\u0072\u0061\u0064\u0065\u0020\u0077\u0069\u0074\u0068\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0061\u006e\u0064\u0020\u0069\u0074\u0073\u0020\u0063\u006f\u006e\u0074\u0065\u006e\u0074\u0073\u0020\u006f\u0072\u0020\u0072\u0069\u0067\u0068\u0074\u0073\u002c\u0020\u006f\u0072\u0020\u0068\u0061\u0076\u0065\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0069\u006e\u0020\u0061\u006e\u0079\u0020\u006f\u0074\u0068\u0065\u0072\u0020\u0077\u0061\u0079\u0020\u0077\u0069\u0074\u0068\u006f\u0075\u0074\u0020\u0070\u0072\u0065\u0076\u0069\u006f\u0075\u0073\u002c\u0020\u0065\u0078\u0070\u0072\u0065\u0073\u0073\u0020\u0061\u006e\u0064\u0020\u0077\u0072\u0069\u0074\u0074\u0065\u006e\u0020\u0061\u0075\u0074\u0068\u006f\u0072\u0069\u007a\u0061\u0074\u0069\u006f\u006e\u0020\u006f\u0066\u0020\u0049\u004f\u004d\u002e\u0020\u0050\u0065\u0072\u006d\u0069\u0073\u0073\u0069\u006f\u006e\u0020\u0074\u006f\u0020\u0075\u0073\u0065\u0020\u006d\u0061\u0074\u0065\u0072\u0069\u0061\u006c\u0073\u0020\u0077\u0068\u0069\u0063\u0068\u0020\u0061\u0072\u0065\u0020\u006e\u006f\u0074\u0020\u006f\u0077\u006e\u0065\u0064\u0020\u0062\u0079\u0020\u0049\u004f\u004d\u0020\u006d\u0075\u0073\u0074\u0020\u0062\u0065\u0020\u0072\u0065\u0071\u0075\u0065\u0073\u0074\u0065\u0064\u0020\u0066\u0072\u006f\u006d\u0020\u0074\u0068\u0065\u0020\u0063\u006f\u0070\u0079\u0072\u0069\u0067\u0068\u0074\u0020\u006f\u0077\u006e\u0065\u0072\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0031\u0030\u002e\u0020\u004c\u0069\u0061\u0062\u0069\u006c\u0069\u0074\u0079\u003c\u002f\u0068\u0033\u003e\u0020\u003c\u0070\u003e\u0059\u006f\u0075\u0020\u0075\u006e\u0064\u0065\u0072\u0073\u0074\u0061\u006e\u0064\u0020\u0074\u0068\u0065\u0020\u0072\u0069\u0073\u006b\u0073\u0020\u006f\u0066\u0020\u0074\u0072\u0061\u006e\u0073\u006d\u0069\u0073\u0073\u0069\u006f\u006e\u0020\u006f\u0066\u0020\u0069\u006e\u0066\u006f\u0072\u006d\u0061\u0074\u0069\u006f\u006e\u0020\u0076\u0069\u0061\u0020\u0074\u0068\u0065\u0020\u0069\u006e\u0074\u0065\u0072\u006e\u0065\u0074\u0020\u0061\u006e\u0064\u0020\u0061\u0063\u0063\u0065\u0070\u0074\u0020\u0074\u0068\u0061\u0074\u0020\u0074\u0068\u0065\u0020\u0073\u0065\u0074\u0074\u0069\u006e\u0067\u002d\u0075\u0070\u0020\u0061\u006e\u0064\u0020\u0075\u0073\u0065\u0020\u006f\u0066\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0069\u0073\u0020\u0061\u0074\u0020\u0079\u006f\u0075\u0072\u0020\u006f\u0077\u006e\u0020\u0072\u0069\u0073\u006b\u002e\u0020\u0059\u006f\u0075\u0020\u0072\u0065\u006c\u0065\u0061\u0073\u0065\u002c\u0020\u0064\u0069\u0073\u0063\u0068\u0061\u0072\u0067\u0065\u0020\u0061\u006e\u0064\u0020\u0061\u0067\u0072\u0065\u0065\u0020\u0074\u006f\u0020\u0068\u006f\u006c\u0064\u0020\u0068\u0061\u0072\u006d\u006c\u0065\u0073\u0073\u0020\u0049\u004f\u004d\u002c\u0020\u0069\u0074\u0073\u0020\u006f\u0066\u0066\u0069\u0063\u0065\u0072\u0073\u002c\u0020\u0065\u006d\u0070\u006c\u006f\u0079\u0065\u0065\u0073\u0020\u0061\u006e\u0064\u0020\u0061\u0067\u0065\u006e\u0074\u0073\u0020\u0066\u0072\u006f\u006d\u0020\u0061\u006e\u0079\u0020\u006c\u0069\u0061\u0062\u0069\u006c\u0069\u0074\u0079\u0020\u006f\u0072\u0020\u0064\u0061\u006d\u0061\u0067\u0065\u0020\u0063\u0061\u0075\u0073\u0065\u0064\u002c\u0020\u0064\u0069\u0072\u0065\u0063\u0074\u006c\u0079\u0020\u006f\u0072\u0020\u0069\u006e\u0064\u0069\u0072\u0065\u0063\u0074\u006c\u0079\u002c\u0020\u0074\u006f\u0020\u0079\u006f\u0075\u002c\u0020\u0079\u006f\u0075\u0072\u0020\u0066\u0061\u006d\u0069\u006c\u0079\u0020\u006f\u0072\u0020\u0072\u0065\u006c\u0061\u0074\u0069\u0076\u0065\u0073\u0020\u0069\u006e\u0020\u0063\u006f\u006e\u006e\u0065\u0063\u0074\u0069\u006f\u006e\u0020\u0077\u0069\u0074\u0068\u0020\u0074\u0068\u0065\u0020\u0075\u0073\u0065\u0020\u006f\u0066\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u002e\u003c\u002f\u0070\u003e\u0020\u0020\u003c\u0068\u0033\u003e\u0031\u0031\u002e\u0020\u0043\u006f\u006e\u0074\u0061\u0063\u0074\u0020\u003c\u0070\u003e\u0049\u0066\u0020\u0079\u006f\u0075\u0020\u0068\u0061\u0076\u0065\u0020\u0061\u006e\u0079\u0020\u0071\u0075\u0065\u0073\u0074\u0069\u006f\u006e\u0073\u0020\u006f\u0072\u0020\u0063\u006f\u006e\u0063\u0065\u0072\u006e\u0073\u0020\u0061\u0062\u006f\u0075\u0074\u0020\u0074\u0068\u0065\u0020\u0050\u0072\u0069\u0076\u0061\u0063\u0079\u0020\u0050\u006f\u006c\u0069\u0063\u0079\u0020\u0061\u006e\u0064\u002f\u006f\u0072\u0020\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u0020\u0054\u0065\u0072\u006d\u0073\u0020\u0061\u006e\u0064\u0020\u0043\u006f\u006e\u0064\u0069\u0074\u0069\u006f\u006e\u0073\u0020\u006f\u0072\u0020\u0069\u0066\u0020\u0079\u006f\u0075\u0020\u0077\u006f\u0075\u006c\u0064\u0020\u006c\u0069\u006b\u0065\u0020\u0074\u006f\u0020\u0072\u0065\u0070\u006f\u0072\u0074\u0020\u0061\u006e\u0079\u0020\u0069\u006e\u0063\u0069\u0064\u0065\u006e\u0074\u0020\u0077\u0069\u0074\u0068\u0020\u0074\u0068\u0065\u0020\u0073\u0079\u0073\u0074\u0065\u006d\u002c\u0020\u0079\u006f\u0075\u0020\u006d\u0061\u0079\u0020\u0063\u006f\u006e\u0074\u0061\u0063\u0074\u0020\u003c\u0061\u0020\u0068\u0072\u0065\u0066\u003d\u0022\u0076\u0061\u0063\u0063\u0069\u006e\u0065\u0061\u0070\u0070\u0040\u0069\u006f\u006d\u002e\u0069\u006e\u0074\u0022\u003e\u0076\u0061\u0063\u0063\u0069\u006e\u0065\u0061\u0070\u0070\u0040\u0069\u006f\u006d\u002e\u0069\u006e\u0074\u003c\u002f\u0061\u003e\u0020\u006f\u0072\u0020\u0067\u006f\u0020\u0064\u0069\u0072\u0065\u0063\u0074\u006c\u0079\u0020\u0074\u006f\u0020\u0074\u0068\u0065\u0020\u0061\u0070\u0070\u006c\u0069\u0063\u0061\u0074\u0069\u006f\u006e\u0020\u0066\u0065\u0065\u0064\u0062\u0061\u0063\u006b\u0020\u0066\u0065\u0061\u0074\u0075\u0072\u0065\u002e\u0020\u0049\u00